<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="TerraEngineOffline" value=".nuget/feed" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="TerraEngineOffline">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
	<config>
		<add key="signatureValidationMode" value="accept" />
	</config>
</configuration>
