    { "id": "terrain-30-minute-soak", "kind": "soak", "durationMinutes": 30, "fixture": "terrain-256km", "route": "terrain-1000km-edit-route", "targetResidentGrowthPercent": 5.0 }
    ,{ "id": "terrain-surface-layers", "kind": "surface-layer-matrix", "fixture": "terrain-flat-4-area", "layerCount": 16, "localContributorLimit": 4, "cases": [ "add", "duplicate", "reorder", "replace", "enable", "disable", "remove", "paint", "erase", "fill", "normalize", "fifth-contributor-preview", "missing-source-fallback", "save-reload-hash" ], "metrics": [ "control-page-residency", "generation-publication", "boundary-seam", "fallback-state" ] },
    { "id": "terrain-jolt-heightfield", "kind": "collision-matrix", "fixture": "terrain-flat-4-area", "backend": "Jolt", "sampleCounts": [257, 513, 1025], "cases": [ "heightfield-build", "shape-replacement", "hole-sentinel", "material-assignment", "query-alignment", "stale-generation", "last-known-good" ], "metrics": [ "build-latency-microseconds", "update-latency-microseconds", "allocation-bytes", "sample-count", "query-alignment-centimetres" ], "targets": { "normalStrokeCurrentSeconds": 1.0, "queryAlignmentCentimetres": 5.0 } },
