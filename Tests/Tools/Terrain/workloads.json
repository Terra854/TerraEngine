    { "id": "terrain-mixed-lod-traversal", "kind": "lod-traversal", "fixture": "terrain-multi-area-lod", "views": [ "perspective", "orthographic", "shadow", "capture", "picking" ], "cases": [ "all-16-stitch-masks", "height-normal-morph", "hole-pinning", "stationary-threshold-60s", "negative-area-boundary" ], "metrics": [ "projected-error-pixels", "balance-repair-count", "stitch-mask", "morph-factor", "crack-pixels", "normal-discontinuity-degrees", "geometry-reduction-percent" ], "targets": { "projectedErrorPixels": 1.5, "crackPixels": 0, "normalDiscontinuityDegrees": 1.0, "geometryReductionPercent": 75.0 } },
