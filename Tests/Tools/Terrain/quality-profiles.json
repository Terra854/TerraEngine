    { "id": "terrain-interactive", "version": 1, "settingsHash": "terrain-interactive-v1", "workloadClass": "interactive", "maxAreas": 4, "maxSamples": 263169, "availability": "reference-contract", "evidenceStatus": "unavailable" },
    { "id": "terrain-large-world", "version": 1, "settingsHash": "terrain-large-world-v1", "workloadClass": "large", "extentKilometres": [256, 256], "fullResidency": false, "availability": "reference-contract", "evidenceStatus": "unavailable" }
  ],
  "artifactHashContract": {
    "algorithm": "SHA256",
    "requiredArtifacts": ["manifest.json", "SaveRecovery/manifest.json", "workloads.json", "runtime-shaders", "editor-shaders"],
