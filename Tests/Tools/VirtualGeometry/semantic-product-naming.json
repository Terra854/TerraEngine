	"protocolMetadataAllowance": {
		"reason": "Version-one validation evidence retains these exact quoted wire identifiers. Only complete quoted content or decoded-content literals in these declared contract files are allowed; descriptions, filenames and all other patterns remain audited.",
		"pattern": "requirement-or-success-criterion",
		"files": [
			"Tests/Support/RendererEfficiency/Editor/EditorRendererEfficiencyValidation.cpp",
			"Tests/Fixtures/RendererEfficiency/workloads.json",
			"Tests/Tools/RendererEfficiency/Compare-RendererEfficiencyEvidence.ps1",
			"Tests/Tools/RendererEfficiency/Schemas/evidence.schema.json"
		],
		"literals": ["SC-001", "SC-002", "SC-003", "SC-004", "SC-005", "SC-006", "SC-007", "SC-008", "SC-009"]
	},
	"textExtensions": [".bat", ".cmd", ".cmake", ".cpp", ".cs", ".frag", ".gltf", ".h", ".hlsl", ".hlsli", ".hpp", ".json", ".md", ".ps1", ".py", ".sh", ".teanimctrl", ".teanimmask", ".teprefab", ".tescene", ".tmat", ".txt", ".vert", ".yaml", ".yml"],
	"maximumTextBytes": 4194304,
	"patterns": [
		{"name": "planning-workflow", "expression": "(?i)(?<![A-Za-z0-9])(?:spec[- ]kit|speckit(?:[-.][A-Za-z]+)*)(?![A-Za-z0-9])"},
		{"name": "planning-document-link", "expression": "(?i)(?<![A-Za-z0-9])specs[/\\\\][0-9]{2,4}[-_]"},
		{"name": "feature-or-specification", "expression": "(?i)(?<![A-Za-z0-9])(?:(?:feature|spec)(?:[-_ `]|%20|%2d|%5f|\\\\u0020|\\\\x20)*0*\\d{1,4}|specs?[/\\\\]0*\\d{2,4}[-_])(?![A-Za-z0-9])"},
		{"name": "user-story", "expression": "(?i)(?<![A-Za-z0-9])US0*\\d{1,3}(?![A-Za-z0-9])"},
		{"name": "requirement-or-success-criterion", "expression": "(?i)(?<![A-Za-z0-9])(?:FR|SC)-0*\\d{1,4}(?![A-Za-z0-9])"},
		{"name": "task", "expression": "(?i)(?<![A-Za-z0-9])T0*\\d{3,5}(?![A-Za-z0-9])"},
		{"name": "numbered-planning-phase", "expression": "(?i)(?<![A-Za-z0-9])phase[-_ ]*0*\\d{1,3}(?![A-Za-z0-9])"},
		{"name": "production-routing-branch", "expression": "(?i)(?<![A-Za-z0-9])0*46-vg-production-routing(?![A-Za-z0-9])"}
	]
}
