{
	"schemaVersion": 1,
	"productRoots": ["Engine", "Editor", "Launcher", "Tests", "Tools", "Docs", "cmake"],
	"rootFiles": ["CMakeLists.txt", "CMakePresets.json", "AGENTS.md", "GEMINI.md", "README.md", ".gitignore", ".gitattributes", ".gitmodules", "global.json"],
	"excludedRoots": [".agents", ".codex", ".specify", "specs", ".git", "graphify-out", "out"],
