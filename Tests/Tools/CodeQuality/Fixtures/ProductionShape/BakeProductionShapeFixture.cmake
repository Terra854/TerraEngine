# Validation-only reproducible coherent set. All paths below are owned outputs.
if(NOT DEFINED BAKER OR NOT DEFINED DESTINATION)
	message(FATAL_ERROR "BAKER and DESTINATION are required")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
set(first "${DESTINATION}/review-shape-first")
set(second "${DESTINATION}/review-shape-second")
execute_process(COMMAND "${BAKER}" "${first}" RESULT_VARIABLE one TIMEOUT 60)
execute_process(COMMAND "${BAKER}" "${second}" RESULT_VARIABLE two TIMEOUT 60)
if(NOT one STREQUAL "0" OR NOT two STREQUAL "0")
	message(FATAL_ERROR "Actual companion importer and mesh cooker must both succeed")
endif()
set(names TerraEngineProductionShapeFixture.temf TerraEngineProductionShapeFixture.teskel TerraEngineProductionShapeFixture.teanim TerraEngineProductionShapeFixture.identity)
set(receipt "")
foreach(name IN LISTS names)
	file(SHA256 "${first}/${name}" first_hash)
	file(SHA256 "${second}/${name}" second_hash)
	if(NOT first_hash STREQUAL second_hash)
		message(FATAL_ERROR "Repeated actual asset bakes differ: ${name}")
	endif()
	file(COPY_FILE "${first}/${name}" "${DESTINATION}/${name}" ONLY_IF_DIFFERENT)
	file(WRITE "${DESTINATION}/${name}.sha256" "${first_hash}\n")
	string(APPEND receipt "${first_hash}  ${name}\n")
endforeach()
file(WRITE "${DESTINATION}/TerraEngineProductionShapeFixture.manifest" "${receipt}")
# Keep the two narrow bake directories as diagnostic receipts; do not recursively
# remove generated import prerequisites or accidentally remove another owner.
