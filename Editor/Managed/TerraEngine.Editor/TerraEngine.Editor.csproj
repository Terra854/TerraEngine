<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Keep IDE/background restores compatible with the runtime-specific,
         self-contained publish issued by CMake on supported hosts. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' != 'Windows_NT'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Keep the editor's managed sources in their own project folder so the SDK
       default file globs only collect editor files, not sibling managed tools. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\Engine\Managed\TerraEngine.csproj" />
    <!-- The vendored Hexa project targets several older TFMs. Pin the editor
         reference to netstandard2.0 so Linux builds with only the .NET 10 SDK
         do not try to restore/build every Hexa target framework. -->
    <ProjectReference Include="..\..\..\External\Hexa.NET.ImGui\Hexa.NET.ImGui\Hexa.NET.ImGui.csproj" TargetFramework="netstandard2.0" SetTargetFramework="TargetFramework=netstandard2.0" AdditionalProperties="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
