<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TerraEngine.CSharp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Export sources (ExportBridge, ExportVTable) are now part of the core 
       engine API so user projects don't need local copies. 
       ExportBootstrap is injected by the Source Generator during export. -->
  <ItemGroup>
    <Compile Remove="Source\Export\ExportBootstrap.cs" />
  </ItemGroup>

</Project>
