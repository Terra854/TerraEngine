{
	"schemaVersion": 2,
	"id": "production-readiness",
	"title": "Production rebuild, package, install, benchmark, and quickstart",
	"requiredTools": ["asset.virtualGeometry.inspect", "asset.virtualGeometry.rebuild", "script.compile", "jobs.cancel", "diagnostics.get_summary", "game_view.capture"],
	"operations": [
		{"id": "inspect-before", "tool": "asset.virtualGeometry.inspect", "evidence": "editor/inspect-before.json"},
		{"id": "rebuild", "tool": "asset.virtualGeometry.rebuild", "evidence": "editor/rebuild.json"},
		{"id": "compile-cancel-target", "tool": "script.compile", "evidence": "editor/compile-cancel-target.json"},
		{"id": "cancel", "tool": "jobs.cancel", "evidence": "editor/cancel.json"},
		{"id": "diagnostics", "tool": "diagnostics.get_summary", "evidence": "editor/diagnostics.json"},
		{"id": "inspect-after", "tool": "asset.virtualGeometry.inspect", "evidence": "editor/inspect-after.json"}
	],
	"captures": [
		{"id": "post-rebuild", "tool": "game_view.capture", "evidence": "images/post-rebuild.png"}
	],
	"requiredArtifacts": [
		{"path": "editor/inspect-before.json", "kind": "editor-envelope"},
		{"path": "editor/rebuild.json", "kind": "editor-envelope"},
		{"path": "editor/diagnostics.json", "kind": "editor-envelope"},
		{"path": "editor/inspect-after.json", "kind": "editor-envelope"},
		{"path": "images/post-rebuild.png", "kind": "png"}
	],
	"releaseGates": ["production-editor-tests", "benchmark-baseline", "benchmark-candidate", "benchmark-comparison", "install", "package", "installed-package-inventory", "quickstart"],
	"unavailablePolicy": "fail-closed"
}
