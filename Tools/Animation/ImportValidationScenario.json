{
	"schemaVersion": 2,
	"phase": "import-validation",
	"requiredTools": [
		"asset.import",
		"asset.list",
		"asset.inspect",
		"prefab.instantiate",
		"diagnostics.get_summary"
	],
	"requiredEvidence": [
		"editor/mcp-operations.json",
		"editor/operations/import-validation-first.json",
		"editor/operations/import-validation-repeat.json",
		"editor/operations/import-validation-query-package.json",
		"editor/operations/import-validation-inspect-package-impact.json",
		"editor/operations/import-validation-failed-reimport-preserves-generation.json",
		"editor/operations/import-validation-recover-valid-source.json",
		"editor/operations/import-validation-instantiate-playable-prefab.json",
		"editor/operations/import-validation-scene-bind-query.json",
		"editor/operations/import-validation-play-diagnostics.json",
		"editor/operations/import-validation-post-play-scene-query.json"
	],
	"operations": [
		{
			"id": "import-validation-first",
			"stage": "prePlay",
			"order": 10,
			"tool": "asset.import",
			"arguments": {
				"path": "Models/ImportedHero.gltf",
				"force": true
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.importResult.generatedMeshes",
					"data.importResult.generatedPrefabs",
					"data.importResult.animationManifest"
				],
				"fieldOneOf": {
					"data.status": [
						"Succeeded",
						"SucceededWithWarnings"
					]
				}
			},
			"evidencePath": "editor/operations/import-validation-first.json"
		},
		{
			"id": "import-validation-repeat",
			"stage": "prePlay",
			"order": 20,
			"tool": "asset.import",
			"arguments": {
				"path": "Models/ImportedHero.gltf",
				"force": true
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.importResult.packageGuid",
					"data.importResult.generatedPrefabs"
				],
				"fieldOneOf": {
					"data.status": [
						"Succeeded",
						"SucceededWithWarnings"
					]
				}
			},
			"evidencePath": "editor/operations/import-validation-repeat.json"
		},
		{
			"id": "import-validation-query-package",
			"stage": "prePlay",
			"order": 30,
			"tool": "asset.list",
			"arguments": {
				"search": "ImportedHero"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.assets"
				]
			},
			"evidencePath": "editor/operations/import-validation-query-package.json"
		},
		{
			"id": "import-validation-inspect-package-impact",
			"stage": "prePlay",
			"order": 40,
			"tool": "asset.inspect",
			"arguments": {
				"asset": "Assets/Models/ImportedHero.gltf",
				"operation": "move",
				"destination": "Assets/Models/ImportedHeroMoved.gltf"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.impact.fingerprint"
				]
			},
			"evidencePath": "editor/operations/import-validation-inspect-package-impact.json"
		},
		{
			"id": "import-validation-failed-reimport-preserves-generation",
			"stage": "prePlay",
			"order": 50,
			"tool": "asset.import",
			"arguments": {
				"path": "Models/ImportedHero.gltf",
				"force": true
			},
			"fileTransition": {
				"target": "Assets/Models/ImportedHero.gltf",
				"replacement": "GateInputs/ImportedHero.invalid.gltf",
				"preserveRoots": [
					"Assets/Models/ImportedHero_Generated",
					"Build/Assets/Models/ImportedHero_Generated"
				]
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.importResult.diagnostics"
				],
				"fieldEquals": {
					"data.status": "Failed"
				}
			},
			"evidencePath": "editor/operations/import-validation-failed-reimport-preserves-generation.json"
		},
		{
			"id": "import-validation-recover-valid-source",
			"stage": "prePlay",
			"order": 60,
			"tool": "asset.import",
			"arguments": {
				"path": "Models/ImportedHero.gltf",
				"force": true
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.importResult.generatedPrefabs"
				],
				"fieldOneOf": {
					"data.status": [
						"Succeeded",
						"SucceededWithWarnings"
					]
				}
			},
			"evidencePath": "editor/operations/import-validation-recover-valid-source.json"
		},
		{
			"id": "import-validation-instantiate-playable-prefab",
			"stage": "prePlay",
			"order": 70,
			"tool": "prefab.instantiate",
			"arguments": {
				"prefab": "Assets/Models/ImportedHero_Generated/ImportedHero.teprefab",
				"name": "Import Validation Hero Playable Prefab"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.instanceId",
					"data.prefabId"
				]
			},
			"evidencePath": "editor/operations/import-validation-instantiate-playable-prefab.json"
		},
		{
			"id": "import-validation-scene-bind-query",
			"stage": "prePlay",
			"order": 80,
			"tool": "scene.list_objects",
			"arguments": {
				"includeComponents": true,
				"search": "Import Validation"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.objects"
				]
			},
			"evidencePath": "editor/operations/import-validation-scene-bind-query.json"
		},
		{
			"id": "import-validation-play-diagnostics",
			"stage": "play",
			"order": 110,
			"tool": "diagnostics.get_summary",
			"arguments": {
				"includeDetails": true,
				"surface": "import-validation-bind-preview"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data"
				]
			},
			"evidencePath": "editor/operations/import-validation-play-diagnostics.json"
		},
		{
			"id": "import-validation-post-play-scene-query",
			"stage": "postPlay",
			"order": 130,
			"tool": "scene.list_objects",
			"arguments": {
				"includeComponents": true,
				"search": "Import Validation Hero Playable Prefab"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.objects"
				]
			},
			"evidencePath": "editor/operations/import-validation-post-play-scene-query.json"
		}
	],
	"captures": [
		{
			"id": "import-validation-scene-view",
			"view": "SceneView",
			"stage": "prePlay",
			"order": 90,
			"tool": "camera.capture_custom",
			"arguments": {
				"name": "Import Validation Import Scene View",
				"position": [
					0,
					1,
					4
				],
				"target": [
					0,
					0.5,
					0
				],
				"up": [
					0,
					1,
					0
				],
				"projection": "perspective",
				"verticalFovDegrees": 60,
				"nearPlane": 0.1,
				"farPlane": 100
			}
		},
		{
			"id": "import-validation-game-view",
			"view": "GameView",
			"stage": "play",
			"order": 120,
			"tool": "game_view.capture",
			"arguments": {
				"includeOverlays": false,
				"transparentBackground": false
			}
		},
		{
			"id": "import-validation-in-game-camera",
			"view": "InGameCamera",
			"stage": "postPlay",
			"order": 140,
			"tool": "camera.capture_object",
			"arguments": {
				"object": "Import Validation Capture Camera",
				"includeDisabled": false,
				"transparentBackground": false
			}
		}
	],
	"visualExpectations": [
		{
			"captureId": "import-validation-scene-view",
			"contentPolicy": "visible-geometry-required"
		},
		{
			"captureId": "import-validation-game-view",
			"contentPolicy": "visible-geometry-required"
		},
		{
			"captureId": "import-validation-in-game-camera",
			"contentPolicy": "visible-geometry-required"
		}
	],
	"visualIdentityExceptions": [
		{
			"captureIds": [
				"import-validation-game-view",
				"import-validation-in-game-camera"
			],
			"reason": "Game View and the authored in-game capture intentionally resolve the same active camera, so exact visual parity is valid."
		}
	],
	"manualChecklist": [
		{
			"id": "import-validation-mouse-asset-inspection",
			"input": "mouse",
			"required": true,
			"minimumInputEvents": 2,
			"instruction": "Using the installed editor and real mouse input, click Models/ImportedHero.gltf and Models/ImportedHero_Generated/ImportedHero.teprefab in the Project Browser. Verify the Inspector exposes the model package and generated prefab rather than loose source-only content. Submit both ordered atomic click requests; the gate captures and binds the native-window screenshot itself."
		},
		{
			"id": "import-validation-keyboard-save-check",
			"input": "keyboard",
			"required": true,
			"minimumInputEvents": 1,
			"instruction": "Using the installed editor Ctrl+S shortcut, save the Import Validation scene after inspecting the generated prefab and confirm the editor remains stopped. Submit the atomic key-chord request; the gate captures and binds the native-window screenshot itself."
		}
	]
}
