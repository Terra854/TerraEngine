{
	"schemaVersion": 2,
	"phase": "us3-controllers",
	"requiredTools": [
		"asset.import",
		"asset.list",
		"animation.asset.inspect",
		"prefab.instantiate",
		"scene.list_objects",
		"animation.controller.validate",
		"animation.controller.edit",
		"diagnostics.get_summary",
		"history.state",
		"play.state"
	],
	"requiredEvidence": [
		"editor/mcp-operations.json",
		"editor/operations/us3-import-visual-package.json",
		"editor/operations/us3-list-cooked-controller-assets.json",
		"editor/operations/us3-inspect-registered-controller.json",
		"editor/operations/us3-inspect-registered-mask.json",
		"editor/operations/us3-validate-cooked-controller-before-edit.json",
		"editor/operations/us3-author-speed-default.json",
		"editor/operations/us3-validate-controller-after-edit.json",
		"editor/operations/us3-reject-invalid-controller-publication.json",
		"editor/operations/us3-validate-last-good-controller.json",
		"editor/operations/us3-instantiate-visual-hero.json",
		"editor/operations/us3-query-visual-hero.json",
		"editor/operations/us3-history-before-play.json",
		"editor/operations/us3-runtime-diagnostics.json",
		"editor/operations/us3-play-state-during-controller-runtime.json",
		"editor/operations/us3-restored-controller-validation.json",
		"editor/operations/us3-query-restored-visual-hero.json",
		"editor/operations/us3-play-state-stopped.json"
	],
	"operations": [
		{
			"id": "us3-import-visual-package",
			"stage": "prePlay",
			"order": 10,
			"tool": "asset.import",
			"arguments": { "path": "Models/US3Hero.gltf", "force": true },
			"expect": {
				"ok": true,
				"requiredFields": ["data.importResult.animationManifest", "data.importResult.generatedPrefabs"],
				"fieldOneOf": { "data.status": ["Succeeded", "SucceededWithWarnings"] }
			},
			"evidencePath": "editor/operations/us3-import-visual-package.json"
		},
		{
			"id": "us3-list-cooked-controller-assets",
			"stage": "prePlay",
			"order": 20,
			"tool": "asset.list",
			"arguments": { "search": "US3LocomotionAction" },
			"expect": { "ok": true, "requiredFields": ["data.assets"] },
			"evidencePath": "editor/operations/us3-list-cooked-controller-assets.json"
		},
		{
			"id": "us3-inspect-registered-controller",
			"stage": "prePlay",
			"order": 25,
			"tool": "animation.asset.inspect",
			"arguments": { "assetId": "3132333435363738393a3b3c3d3e3f40", "correlationId": "us3-inspect-controller" },
			"expect": {
				"ok": true,
				"requiredFields": ["data.assetId", "data.immutable", "data.importer", "data.registeredAssetId", "data.sourcePath"],
				"fieldEquals": {
					"data.assetId": "3132333435363738393a3b3c3d3e3f40",
					"data.immutable": true,
					"data.importer": "AnimationControllerAssetImporter",
					"data.registeredAssetId": "3132333435363738393a3b3c3d3e3f40"
				}
			},
			"evidencePath": "editor/operations/us3-inspect-registered-controller.json"
		},
		{
			"id": "us3-inspect-registered-mask",
			"stage": "prePlay",
			"order": 26,
			"tool": "animation.asset.inspect",
			"arguments": { "assetId": "5152535455565758595a5b5c5d5e5f60", "correlationId": "us3-inspect-mask" },
			"expect": {
				"ok": true,
				"requiredFields": ["data.assetId", "data.immutable", "data.importer", "data.registeredAssetId", "data.sourcePath"],
				"fieldEquals": {
					"data.assetId": "5152535455565758595a5b5c5d5e5f60",
					"data.immutable": true,
					"data.importer": "AnimationMaskAssetImporter",
					"data.registeredAssetId": "5152535455565758595a5b5c5d5e5f60"
				}
			},
			"evidencePath": "editor/operations/us3-inspect-registered-mask.json"
		},
		{
			"id": "us3-validate-cooked-controller-before-edit",
			"stage": "prePlay",
			"order": 30,
			"tool": "animation.controller.validate",
			"arguments": { "assetId": "3132333435363738393a3b3c3d3e3f40", "maximumDiagnostics": 64, "correlationId": "us3-before-edit" },
			"expect": {
				"ok": true,
				"requiredFields": ["data.valid", "data.status", "data.counts.parameters", "data.counts.nodes", "data.counts.transitions", "data.counts.layers", "data.diagnostics"],
				"fieldEquals": { "data.valid": true, "data.status": "ok" }
			},
			"evidencePath": "editor/operations/us3-validate-cooked-controller-before-edit.json"
		},
		{
			"id": "us3-author-speed-default",
			"stage": "prePlay",
			"order": 40,
			"tool": "animation.controller.edit",
			"arguments": {
				"assetId": "3132333435363738393a3b3c3d3e3f40",
				"idempotencyKey": "us3-speed-default-v1",
				"correlationId": "us3-speed-default-v1",
				"expectedGeneration": 1,
				"payload": { "action": "set_parameter_default", "stableId": 100, "floatValue": 0.75 }
			},
			"expect": { "ok": true, "requiredFields": ["data.action", "data.stableId", "data.counts", "data.publication", "data.generation"], "fieldEquals": { "data.publication": "asset_database_atomic_copy", "data.generation": 2 } },
			"evidencePath": "editor/operations/us3-author-speed-default.json"
		},
		{
			"id": "us3-validate-controller-after-edit",
			"stage": "prePlay",
			"order": 50,
			"tool": "animation.controller.validate",
			"arguments": { "assetId": "3132333435363738393a3b3c3d3e3f40", "maximumDiagnostics": 64, "correlationId": "us3-after-edit" },
			"expect": { "ok": true, "requiredFields": ["data.valid", "data.counts", "data.diagnostics"], "fieldEquals": { "data.valid": true } },
			"evidencePath": "editor/operations/us3-validate-controller-after-edit.json"
		},
		{
			"id": "us3-reject-invalid-controller-publication",
			"stage": "prePlay",
			"order": 60,
			"tool": "animation.controller.edit",
			"arguments": {
				"assetId": "3132333435363738393a3b3c3d3e3f40",
				"idempotencyKey": "us3-invalid-publication-v1",
				"correlationId": "us3-invalid-publication-v1",
				"expectedGeneration": 2,
				"payload": { "action": "add_transition", "stableId": 499, "sourceStateId": 400, "destinationStateId": 401, "conditionParameterId": 999 }
			},
			"expect": { "ok": false, "errorCategory": "validation" },
			"evidencePath": "editor/operations/us3-reject-invalid-controller-publication.json"
		},
		{
			"id": "us3-validate-last-good-controller",
			"stage": "prePlay",
			"order": 70,
			"tool": "animation.controller.validate",
			"arguments": { "assetId": "3132333435363738393a3b3c3d3e3f40", "maximumDiagnostics": 64, "correlationId": "us3-last-good" },
			"expect": { "ok": true, "requiredFields": ["data.valid", "data.counts.transitions", "data.diagnostics"], "fieldEquals": { "data.valid": true } },
			"evidencePath": "editor/operations/us3-validate-last-good-controller.json"
		},
		{
			"id": "us3-instantiate-visual-hero",
			"stage": "prePlay",
			"order": 80,
			"tool": "prefab.instantiate",
			"arguments": { "prefab": "Assets/Models/US3Hero_Generated/US3Hero.teprefab", "name": "US3 Controller Hero" },
			"expect": { "ok": true, "requiredFields": ["data.instanceId", "data.prefabId"] },
			"evidencePath": "editor/operations/us3-instantiate-visual-hero.json"
		},
		{
			"id": "us3-query-visual-hero",
			"stage": "prePlay",
			"order": 90,
			"tool": "scene.list_objects",
			"arguments": { "includeComponents": true, "search": "US3 Controller Hero" },
			"expect": { "ok": true, "requiredFields": ["data.objects"] },
			"evidencePath": "editor/operations/us3-query-visual-hero.json"
		},
		{
			"id": "us3-history-before-play",
			"stage": "prePlay",
			"order": 110,
			"tool": "history.state",
			"arguments": {},
			"expect": { "ok": true, "requiredFields": ["data"] },
			"evidencePath": "editor/operations/us3-history-before-play.json"
		},
		{
			"id": "us3-runtime-diagnostics",
			"stage": "play",
			"order": 130,
			"tool": "diagnostics.get_summary",
			"arguments": { "includeDetails": true, "surface": "us3-controller-runtime" },
			"expect": { "ok": true, "requiredFields": ["data"] },
			"evidencePath": "editor/operations/us3-runtime-diagnostics.json"
		},
		{
			"id": "us3-play-state-during-controller-runtime",
			"stage": "play",
			"order": 140,
			"tool": "play.state",
			"arguments": {},
			"expect": { "ok": true, "requiredFields": ["data.currentState"], "fieldOneOf": { "data.currentState": ["playing", "paused"] } },
			"evidencePath": "editor/operations/us3-play-state-during-controller-runtime.json"
		},
		{
			"id": "us3-restored-controller-validation",
			"stage": "postPlay",
			"order": 160,
			"tool": "animation.controller.validate",
			"arguments": { "assetId": "3132333435363738393a3b3c3d3e3f40", "maximumDiagnostics": 64, "correlationId": "us3-restored" },
			"expect": { "ok": true, "requiredFields": ["data.valid", "data.counts", "data.diagnostics"], "fieldEquals": { "data.valid": true } },
			"evidencePath": "editor/operations/us3-restored-controller-validation.json"
		},
		{
			"id": "us3-query-restored-visual-hero",
			"stage": "postPlay",
			"order": 170,
			"tool": "scene.list_objects",
			"arguments": { "includeComponents": true, "search": "US3 Controller Hero" },
			"expect": { "ok": true, "requiredFields": ["data.objects"] },
			"evidencePath": "editor/operations/us3-query-restored-visual-hero.json"
		},
		{
			"id": "us3-play-state-stopped",
			"stage": "postPlay",
			"order": 180,
			"tool": "play.state",
			"arguments": {},
			"expect": { "ok": true, "requiredFields": ["data.currentState"], "fieldEquals": { "data.currentState": "stopped" } },
			"evidencePath": "editor/operations/us3-play-state-stopped.json"
		}
	],
	"captures": [
		{
			"id": "us3-controller-scene-view",
			"view": "SceneView",
			"stage": "prePlay",
			"order": 100,
			"tool": "camera.capture_custom",
			"arguments": { "name": "US3 Controller Scene View", "position": [0, 1, 4], "target": [0, 0.5, 0], "up": [0, 1, 0], "projection": "perspective", "verticalFovDegrees": 60, "nearPlane": 0.1, "farPlane": 100 }
		},
		{
			"id": "us3-controller-game-view",
			"view": "GameView",
			"stage": "play",
			"order": 150,
			"tool": "game_view.capture",
			"arguments": { "includeOverlays": false, "transparentBackground": false }
		},
		{
			"id": "us3-controller-in-game-camera",
			"view": "InGameCamera",
			"stage": "postPlay",
			"order": 190,
			"tool": "camera.capture_object",
			"arguments": { "object": "US3 Capture Camera", "includeDisabled": false, "transparentBackground": false }
		}
	],
	"visualExpectations": [
		{ "captureId": "us3-controller-scene-view", "contentPolicy": "visible-geometry-required" },
		{ "captureId": "us3-controller-game-view", "contentPolicy": "visible-geometry-required" },
		{ "captureId": "us3-controller-in-game-camera", "contentPolicy": "visible-geometry-required" }
	],
	"visualIdentityExceptions": [
		{
			"captureIds": ["us3-controller-game-view", "us3-controller-in-game-camera"],
			"reason": "Game View and the authored US3 Capture Camera intentionally resolve the same active view, so their pixel-identical output is expected evidence rather than a vacuous duplicate."
		}
	],
	"manualChecklist": [
		{
			"id": "us3-mouse-author-and-observe-controller",
			"input": "mouse",
			"required": true,
			"minimumInputEvents": 8,
			"instruction": "Using the installed editor and real mouse input, complete and visually inspect the controller workflow: select Assets/Controllers/US3LocomotionAction.teanimctrl and Assets/Masks/US3UpperBody.teanimmask; inspect typed parameters, blend nodes, transitions, layers, mask, and sync markers; then attach the controller and compatible generated US3 hero skeleton through the advertised Inspector controls and observe a preview or Play Mode transition after changing Speed/Direction and firing PlayAction. Submit the ordered atomic mouse events in one checklist record only after that observed workflow. The gate captures its own native screenshot at request time; do not claim unobservable state, pose, or root-motion values as MCP facts."
		},
		{
			"id": "us3-keyboard-save-undo-and-restore",
			"input": "keyboard",
			"required": true,
			"minimumInputEvents": 4,
			"instruction": "Using real keyboard input, complete the persistence workflow: save with Ctrl+S, undo/redo the authored Inspector assignment, save/reload, then reopen the controller and visually check its validation panel after the rejected MCP edit. Leave the editor stopped and submit the ordered atomic key events in one checklist record only after this observed workflow. The gate captures its own native screenshot at request time and separately verifies Play Mode restoration; this manual report is not a substitute for per-keystroke evidence."
		}
	]
}
