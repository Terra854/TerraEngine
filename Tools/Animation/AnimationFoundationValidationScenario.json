{
	"schemaVersion": 2,
	"phase": "foundation",
	"requiredTools": [
		"diagnostics.get_summary"
	],
	"requiredEvidence": [
		"editor/mcp-operations.json",
		"editor/operations/foundation-scene-contents.json",
		"editor/operations/foundation-scene-view-state.json",
		"editor/operations/foundation-diagnostics.json"
	],
	"operations": [
		{
			"id": "foundation-scene-contents",
			"stage": "prePlay",
			"order": 10,
			"tool": "scene.list_objects",
			"arguments": {
				"includeComponents": true
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.objects"
				]
			},
			"evidencePath": "editor/operations/foundation-scene-contents.json"
		},
		{
			"id": "foundation-scene-view-state",
			"stage": "prePlay",
			"order": 20,
			"tool": "scene_view.state",
			"expect": {
				"ok": true,
				"requiredFields": [
					"data.state"
				]
			},
			"evidencePath": "editor/operations/foundation-scene-view-state.json"
		},
		{
			"id": "foundation-diagnostics",
			"stage": "play",
			"order": 40,
			"tool": "diagnostics.get_summary",
			"arguments": {
				"includeDetails": true,
				"surface": "foundation-zero-animator"
			},
			"expect": {
				"ok": true,
				"requiredFields": [
					"data"
				]
			},
			"evidencePath": "editor/operations/foundation-diagnostics.json"
		}
	],
	"captures": [
		{
			"id": "foundation-scene-view",
			"view": "SceneView",
			"stage": "prePlay",
			"order": 30,
			"tool": "camera.capture_custom",
			"arguments": {
				"name": "Foundation Scene View",
				"position": [
					0,
					3,
					7
				],
				"target": [
					0,
					0,
					0
				],
				"up": [
					0,
					1,
					0
				],
				"projection": "perspective",
				"verticalFovDegrees": 60,
				"nearPlane": 0.1,
				"farPlane": 100
			}
		},
		{
			"id": "foundation-game-view",
			"view": "GameView",
			"stage": "play",
			"order": 50,
			"tool": "game_view.capture",
			"arguments": {
				"includeOverlays": false,
				"transparentBackground": false
			}
		},
		{
			"id": "foundation-in-game-camera",
			"view": "InGameCamera",
			"stage": "postPlay",
			"order": 60,
			"tool": "camera.capture_object",
			"arguments": {
				"object": "Foundation Capture Camera",
				"includeDisabled": false,
				"transparentBackground": false
			}
		}
	],
	"visualExpectations": [
		{
			"captureId": "foundation-scene-view",
			"contentPolicy": "visible-geometry-required"
		},
		{
			"captureId": "foundation-game-view",
			"contentPolicy": "visible-geometry-required"
		},
		{
			"captureId": "foundation-in-game-camera",
			"contentPolicy": "visible-geometry-required"
		}
	],
	"visualIdentityExceptions": [
		{
			"captureIds": [
				"foundation-game-view",
				"foundation-in-game-camera"
			],
			"reason": "Game View and the authored in-game capture intentionally resolve the same active camera, so exact visual parity is valid."
		}
	],
	"manualChecklist": [
		{
			"id": "foundation-mouse-scene-inspection",
			"input": "mouse",
			"required": true,
			"instruction": "Using the installed editor, click the Foundation Static Reference and Foundation Capture Camera in the hierarchy and verify the inspector exposes no AnimatorComponent on either object. Click the toolbar Play button once, confirm the empty foundation scene remains stable, then click Stop and leave the editor stopped. Save real screenshots beneath the gate run root and reference them from the matching clicks.jsonl record."
		},
		{
			"id": "foundation-keyboard-save-check",
			"input": "keyboard",
			"required": true,
			"instruction": "Using the installed editor Ctrl+S shortcut, save the inspected foundation scene and confirm the editor remains in stopped Play Mode. Save a real screenshot or editor log beneath the gate run root and reference it from the matching clicks.jsonl record. The gate performs a separate scripted MCP Play Mode cycle after this manual input check."
		}
	]
}
