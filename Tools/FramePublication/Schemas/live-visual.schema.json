{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["identity", "views", "captures", "uniqueCaptureHashCount", "unchangedByteIdentity", "expectedFrameIdentity", "passed"],
  "properties": {
    "identity": { "type": "object" },
    "views": { "type": "array", "minItems": 2 },
    "captures": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "object", "required": ["sha256"] }
    },
    "uniqueCaptureHashCount": { "type": "integer", "minimum": 1 },
    "unchangedByteIdentity": { "type": "boolean" },
    "expectedFrameIdentity": { "type": "boolean" },
    "passed": { "type": "boolean" }
  }
}
